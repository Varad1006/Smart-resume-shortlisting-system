# Copy to .env and adjust. Every setting is optional.
# .env is git-ignored and docker-ignored: keep keys there, never in the repository.

APP_PORT=8000

# Scanned resumes, photos and handwriting
OCR_KEY=
OCR_MODE=balanced

# AI summaries (optional)
AI_SUMMARY_KEY=

# Ranking
DEFAULT_SHORTLIST_SIZE=10
RETRIEVAL_TOP_K=20
SEMANTIC_WEIGHT=0.3
COVERAGE_WEIGHT=0.7
SOCIAL_MAX_BONUS=10
# Optional: raises the limit for public GitHub profile lookups.
GITHUB_TOKEN=

# Limits
MAX_FILES=50
MAX_FILE_MB=10
MAX_TOTAL_MB=100
MAX_PDF_PAGES=10
MAX_CONCURRENT_RUNS=1
LOG_LEVEL=INFO
