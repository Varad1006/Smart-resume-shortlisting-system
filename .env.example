# Copy to .env and adjust. Every setting is optional; defaults are shown.
# .env is git-ignored and docker-ignored: keep API keys there, never in the repository.

# Host port used by docker compose.
APP_PORT=8000

# --- OCR -------------------------------------------------------------------------

OCR_ENGINE=auto
# Any OpenAI-compatible server hosting datalab-to/chandra-ocr-2 (vLLM). docker-compose
# sets http://chandra:8000/v1 for the bundled GPU service; use your GPU box's URL otherwise.
# CHANDRA_API_BASE=http://my-gpu-server:8000/v1
CHANDRA_MODEL_NAME=chandra
CHANDRA_API_KEY=EMPTY
# Tesseract languages, "+"-separated. The Docker image ships eng, hin and mar.
TESSERACT_LANGS=eng

# --- Models (multilingual by default) ----------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# cpu | cuda | mps | auto
MODEL_DEVICE=cpu
# Load models at startup instead of on the first request.
WARMUP_MODELS=false

# --- Ranking -----------------------------------------------------------------------
DEFAULT_SHORTLIST_SIZE=10
# Resumes promoted from semantic retrieval to requirement matching.
RETRIEVAL_TOP_K=20
SEMANTIC_WEIGHT=0.3
COVERAGE_WEIGHT=0.7
# Maximum bonus for public GitHub/LeetCode/CodeChef activity (opt-in per run).
SOCIAL_MAX_BONUS=10

# LLM_API_KEY=gsk_...
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_DISPLAY_NAME="GPT-OSS 120B [Groq]"
# Per-request output cap. Providers count it against tokens-per-minute limits (Groq's
# free tier allows 8,000/min), so don't use the model maximum (65,536) here.
LLM_MAX_TOKENS=1200
# For reasoning models (gpt-oss, o-series); leave empty for other models.
LLM_REASONING_EFFORT=low
# How many of the top shortlisted candidates get a summary per run.
LLM_MAX_CANDIDATES=5

# GITHUB_TOKEN=

# --- Limits & server -----------------------------------------------------------------
MAX_FILES=50
MAX_FILE_MB=10
MAX_TOTAL_MB=100
MAX_PDF_PAGES=10
MAX_CONCURRENT_RUNS=1
LOG_LEVEL=INFO

# --- Chandra GPU service (docker compose --profile gpu) ----------------------------
# Tuned for a 24 GB GPU; use 64 / 8192 on an 80 GB H100/A100.
# CHANDRA_MAX_NUM_SEQS=16
# CHANDRA_MAX_BATCHED_TOKENS=2048
# HF_TOKEN=
